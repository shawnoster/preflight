# Legacy in-clone locations of user data. Config and state now live outside the clone
# (lib/paths.sh), but an install that was updated in place still has files here until
# they are moved by hand, and they must not show up as untracked (or get committed:
# env sets hold op:// references). Safe to drop once existing installs have moved.
config/accounts.sh
config/owl.sh
config/envsets/
state/

# Legacy PowerShell settings, no longer read (see pwsh/README.md); kept ignored so an updated
# install does not show it as untracked or commit its secret references.
pwsh/config/accounts.ps1

# Your own shell functions; sourced with the other lib/*.sh (install.sh and
# `preflight update` point users here)
lib/local.sh

# Environment-specific overrides
.env
.env.local

# Claude Code local settings
.claude/settings.local.json
bin/__pycache__/
