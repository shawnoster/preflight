#!/usr/bin/env bash
# git-credential-op — resolve git credentials from 1Password at call time.
#
# Keeps tokens out of ~/.git-credentials and out of remote URLs: the secret
# lives only in 1Password and is read on demand.
#
# Configure per host, e.g.:
#   git config --global credential."https://git.example.com".helper \
#     '!git-credential-op "op://Vault/Item/credential" myuser'
#
# Only `get` is implemented. `store` and `erase` are intentional no-ops —
# there is nothing local to persist or clear.

set -euo pipefail

[ "${1:-}" = get ] || exit 0

OP_REF="${2:-}"
OP_USER="${3:-git}"
[ -n "$OP_REF" ] || { echo "git-credential-op: missing op:// reference" >&2; exit 1; }

# On WSL prefer op.exe: the native Linux op has no desktop-app integration and
# always reports "not currently signed in". See dev/linux/wsl.md.
_op=""
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    if command -v op.exe >/dev/null 2>&1; then
        _op="$(command -v op.exe)"
    else
        for _p in /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_*/op.exe \
                  /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Links/op.exe \
                  "/mnt/c/Program Files/1Password CLI/op.exe"; do
            [ -x "$_p" ] && { _op="$_p"; break; }
        done
    fi
fi
[ -n "$_op" ] || _op="$(command -v op 2>/dev/null || true)"
[ -n "$_op" ] || { echo "git-credential-op: no 1Password CLI found" >&2; exit 1; }

# Strip CR: op.exe emits Windows line endings, which would corrupt the value.
secret="$("$_op" read "$OP_REF" 2>/dev/null | tr -d '\r\n')"
[ -n "$secret" ] || { echo "git-credential-op: could not read $OP_REF" >&2; exit 1; }

printf 'username=%s\npassword=%s\n' "$OP_USER" "$secret"
